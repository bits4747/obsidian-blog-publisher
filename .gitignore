# 依赖与构建产物
# （.next 是 Next 构建/开发缓存，*.tsbuildinfo 是 TS 增量缓存：
#   两者都可由 npm run build / npm run dev 自动重建，不要入库。）
node_modules
.next
out
*.log
*.tsbuildinfo

# 构建产物：由 scripts/build-content.mjs 在 CI 里从 content/ 重新生成，
# 不需要入库（否则每次发布都要提交上百个 JSON 与全部附件副本）。
public/data
public/assets

# 主题预览图的临时工作目录：_dev/gen-theme-previews.mjs 用它装「假内容 + 构建产物」，
# 截图完就没用了。产物是 _dev/_preview_shots/*.png → scripts/theme-previews.mjs。
_dev_preview/

# 个人数据：已全部迁到用户数据目录（Windows %APPDATA%\obsidian-blog，
# macOS ~/Library/Application Support/obsidian-blog，Linux ~/.config/obsidian-blog），
# 源目录只放代码、可以直接开源。下面几项是历史遗留位置的安全网，
# 万一有人手动放回来也不至于把个人信息提交进仓库。
.env
.sync-manifest.json
local.json
connections.json
repos/
content/
