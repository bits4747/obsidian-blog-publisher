{
  "name": "obsidian-blog",
  "version": "1.0.0",
  "private": true,
  "description": "把 Obsidian 笔记发布成 GitHub Pages 静态博客：图形化选公开笔记、一键推送、自动同步、六套外观预设",
  "license": "MIT",
  "author": "bits47",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "static-site",
    "blog",
    "github-pages",
    "nextjs",
    "markdown"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/build-content.mjs",
    "dev": "next dev -p 3010",
    "postdev": "node scripts/build-content.mjs --finalize",
    "build": "node scripts/build-content.mjs && next build && node scripts/build-content.mjs --finalize",
    "preview": "node scripts/serve.mjs",
    "dev:manager": "node scripts/manager.mjs",
    "plugin": "node obsidian-plugin/esbuild.config.mjs",
    "presets": "node scripts/gen-theme-presets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p obsidian-plugin/tsconfig.json",
    "test": "bash scripts/e2e-run.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "0.544.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  }
}
